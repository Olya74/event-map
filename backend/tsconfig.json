{
  "compilerOptions": {
    //  "baseUrl": ".",
    "paths": {
     "@event-map/shared": ["../packages/shared/dist"]
    },
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
 "typeRoots": ["./node_modules/@types", "src/types"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
